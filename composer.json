{
    "name": "super-kernel/skeleton",
    "description": "Project template for the SuperKernel framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-swoole": ">=6.2.3 <6.3",
        "psr/http-message": "^2.0",
        "super-kernel/aop": "^1.0.0-alpha.1",
        "super-kernel/attribute": "^1.0.0-alpha.1",
        "super-kernel/autoloader": "^1.0.0-alpha.1",
        "super-kernel/command": "^1.0.0-alpha.1",
        "super-kernel/config": "^1.0.0-alpha.1",
        "super-kernel/context": "^1.0.0-alpha.1",
        "super-kernel/contract": "^1.0.0-alpha.1",
        "super-kernel/di": "^1.0.0-alpha.1",
        "super-kernel/environment": "^1.0.0-alpha.1",
        "super-kernel/event-dispatcher": "^1.0.0-alpha.1",
        "super-kernel/exception-dispatcher": "^1.0.0-alpha.1",
        "super-kernel/framework": "^1.0.0-alpha.1",
        "super-kernel/http-message": "^1.0.0-alpha.1",
        "super-kernel/http-server": "^1.0.0-alpha.1",
        "super-kernel/logger": "^1.0.0-alpha.1",
        "super-kernel/process": "^1.0.0-alpha.1",
        "super-kernel/server": "^1.0.0-alpha.1",
        "super-kernel/swoole": "^1.0.0-alpha.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5",
        "swoole/ide-helper": "^6.2.3"
    },
    "autoload": {
        "psr-4": {
            "Src\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Src\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true,
        "vendor-dir": "vendor"
    },
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "start": "@php bin/bootstrap.php swoole:start",
        "test": "@php vendor/bin/phpunit"
    }
}
